{
  "name": "melancholy",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@vinext/cloudflare": "^1.0.0-beta.11",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.0-beta.13",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/vitest-plugin": "^1.2.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "prettier": "^3.9.9",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:connector": "node --test tests/adapters.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib worker tests docs packages README.md vite.config.ts vitest.config.ts",
    "db:local": "wrangler d1 migrations apply melancholy --local",
    "db:remote": "wrangler d1 migrations apply melancholy --remote",
    "cf:types": "wrangler types"
  },
  "description": "A minimal Slack-style workspace for people and agents, on Cloudflare.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adayinthepark/melancholy.git"
  },
  "bin": {
    "melancholy-connect": "packages/connector/bin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
